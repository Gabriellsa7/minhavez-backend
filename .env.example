# Database
DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=cluster

# Server
PORT=3001
TZ=America/Sao_Paulo

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key
REFRESH_TOKEN_EXPIRATION=7d

# Redis / BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=

# Notifications
EXPO_ACCESS_TOKEN=
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=2000
NOTIFICATION_QUEUE_TTL=86400000

# WebSocket (queue/notification realtime gateway)
WS_PORT=3002

# Cloudinary (file storage for user/health-unit images and exam PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=minha-vez-app
